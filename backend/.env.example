# ==========================================
# ARQUITECTURA DEL PROYECTO
# ==========================================
# - Base de Datos: PostgreSQL 18 en Windows LOCAL (NO en Docker).
#   La especialista de BD la ejecuta con setup_cajadb_maestra.sql en su pgAdmin.
# - Backend + Frontend: Corren en Docker con docker compose up -d
#
# ==========================================
# Base de Datos (PostgreSQL 18 - cajadb)
# ==========================================
# Desde Docker -> usa host.docker.internal para llegar al Postgres de Windows:
ConnectionStrings__DefaultConnection="Host=host.docker.internal;Port=5432;Database=cajadb;Username=postgres;Password=postgrespassword123"

# Si corres el backend directamente en Windows (sin Docker), usa localhost:
# ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=cajadb;Username=postgres;Password=postgrespassword123"

# ==========================================
# Autenticación JWT (Mínimo 32 bytes UTF-8)
# ==========================================
Jwt__SecretKey="TecNM_Monclova_SuperSecretKey_2026_Min32Bytes!"
Jwt__Issuer="TecNM.Api"
Jwt__Audience="TecNM.Frontend"
Jwt__LifetimeHours=8

# ==========================================
# CORS (Frontend)
# ==========================================
Cors__AllowedOrigin="http://localhost:5173"
